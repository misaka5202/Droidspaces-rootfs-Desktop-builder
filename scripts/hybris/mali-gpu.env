# 由 setup-mali-hybris.sh 生成
export XDG_RUNTIME_DIR=/run/user/1000
export LD_LIBRARY_PATH=/opt/hy/inst/lib
export HYBRIS_PATCH_TLS=1
export HYBRIS_EGLPLATFORM=null
export LIBEGL=/vendor/lib64/egl/libGLES_mali.so
export LIBGLESV2=/vendor/lib64/egl/libGLES_mali.so
export HYBRIS_LD_LIBRARY_PATH=/opt/hy/android:/vendor/lib64/egl:/vendor/lib64/hw:/vendor/lib64:/system/lib64:/system_ext/lib64:/apex/com.android.vndk.v34/lib64
